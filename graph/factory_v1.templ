package graph

import (
	"fmt"
	"strconv"
)

templ factoryV1MissionControlSurface(view FactoryV1MissionControl) {
	<section
		id="factory-v1-mission-control"
		class="space-y-6"
		data-console-surface="factory-v1"
		hx-get="/console/factory-v1/fragment"
		hx-trigger="every 2s"
		hx-swap="outerHTML"
	>
		<header class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
			<div>
				<h2 class="text-lg font-medium text-warm">Civilization / Dark Factory v1</h2>
				<p class="mt-1 max-w-3xl text-sm text-warm-muted">One live projection for canonical intake, TLC execution, gate evidence, exact-head PR readiness, and bounded Human intervention.</p>
			</div>
			@consoleFreshnessBadge(view.Freshness, view.GeneratedAt)
		</header>

		if view.Freshness == FreshnessUnavailable {
			<div class="rounded-lg border border-edge bg-surface p-6" data-state="unavailable">
				<p class="text-sm font-medium text-warm">Factory v1 unavailable</p>
				<p class="mt-2 text-sm text-warm-muted">{ noticeText(view.Notices) }</p>
				<p class="mt-3 text-xs text-warm-faint">No intake or intervention commands are rendered until a supported, timestamped Hive projection is available.</p>
			</div>
		} else {
			@factoryV1ServiceStrip(view)
			if len(view.Notices) > 0 {
				<p class="rounded border border-amber-500/40 bg-amber-500/5 px-3 py-2 text-xs text-amber-300" data-state="partial">{ noticeText(view.Notices) }</p>
			}
			@factoryV1Intake(view)
			@factoryV1InterventionQueue(view.Interventions, view.Writable)
			@factoryV1Orders(view.Orders)
		}
	</section>
}

templ factoryV1ServiceStrip(view FactoryV1MissionControl) {
	<div class="grid grid-cols-2 gap-3 rounded-lg border border-edge bg-surface p-4 md:grid-cols-5" data-factory-v1-service>
		@factoryV1Metric("service", factoryV1ServiceStatus(view.Service))
		@factoryV1Metric("instance", factoryV1ServiceIdentity(view.Service))
		@factoryV1Metric("recovery generation", strconv.FormatInt(factoryV1RecoveryGeneration(view.Service), 10))
		@factoryV1Metric("orders", strconv.Itoa(len(view.Orders)))
		@factoryV1Metric("open interventions", strconv.Itoa(factoryV1OpenInterventionCount(view.Interventions)))
	</div>
}

templ factoryV1Metric(label, value string) {
	<div class="min-w-0">
		<p class="text-[10px] uppercase tracking-widest text-warm-faint">{ label }</p>
		<p class="mt-1 truncate font-mono text-xs text-warm-secondary" title={ value }>{ value }</p>
	</div>
}

templ factoryV1Intake(view FactoryV1MissionControl) {
	<section class="space-y-3" data-factory-v1-intake>
		<div class="flex items-center justify-between gap-3">
			<div>
				<h3 class="text-sm font-medium text-warm">Human intake</h3>
				<p class="mt-1 text-xs text-warm-muted">Ideas remain candidates until explicitly approved. Completed FactoryOrders enter the same canonical queue directly.</p>
			</div>
			if !view.Writable {
				<span class="rounded-full border border-amber-500/40 px-2 py-1 text-[10px] uppercase tracking-wide text-amber-300">writes unavailable</span>
			}
		</div>
		if view.Writable {
			<div class="grid gap-4 lg:grid-cols-2">
				<form method="post" action="/console/factory-v1/ideas" class="space-y-3 rounded-lg border border-edge bg-surface p-4" data-factory-v1-form="idea">
					<div>
						<h4 class="text-sm font-medium text-warm">Idea / iterative refinement</h4>
						<p class="mt-1 text-xs text-warm-muted">Create a candidate here, then refine and approve it from its visible revision card below.</p>
					</div>
					@factoryV1TextInput("factory-v1-idea-title", "title", "Title", "A bounded product outcome", true)
					@factoryV1TextInput("factory-v1-idea-repo", "target_repository", "Target repository", "transpara-ai/repository", true)
					<label class="block text-xs text-warm-muted" for="factory-v1-idea-body">Idea</label>
					<textarea id="factory-v1-idea-body" name="idea" rows="5" required maxlength="12000" hx-preserve class="w-full rounded border border-edge bg-void px-3 py-2 text-sm text-warm outline-none focus:border-brand" placeholder="Describe the intended outcome, constraints, and acceptance evidence."></textarea>
					<button type="submit" class="rounded bg-brand px-3 py-2 text-sm font-medium text-void hover:opacity-90">Create candidate</button>
				</form>

				<form method="post" action="/console/factory-v1/orders" class="space-y-3 rounded-lg border border-edge bg-surface p-4" data-factory-v1-form="completed-order">
					<div>
						<h4 class="text-sm font-medium text-warm">Completed FactoryOrder</h4>
						<p class="mt-1 text-xs text-warm-muted">Submit one structured JSON object. Hive performs the canonical validation and rendering.</p>
					</div>
					<label class="block text-xs text-warm-muted" for="factory-v1-completed-order">FactoryOrder JSON</label>
					<textarea id="factory-v1-completed-order" name="factory_order" rows="10" required maxlength="100000" hx-preserve spellcheck="false" class="w-full rounded border border-edge bg-void px-3 py-2 font-mono text-xs text-warm outline-none focus:border-brand" placeholder={ factoryV1OrderPlaceholder() }></textarea>
					<button type="submit" class="rounded bg-brand px-3 py-2 text-sm font-medium text-void hover:opacity-90">Submit completed order</button>
				</form>
			</div>
		} else {
			<p class="rounded-lg border border-edge bg-surface p-4 text-sm text-warm-muted" data-state="writes-unavailable">Intake is fail-closed while the projection is stale, partial, or the service is not confirmed running.</p>
		}

		if len(view.Ideas) > 0 {
			<div class="space-y-3" data-factory-v1-ideas>
				<h4 class="text-xs uppercase tracking-widest text-warm-faint">Idea candidates</h4>
				for _, idea := range view.Ideas {
					@factoryV1IdeaCard(idea, view.Writable)
				}
			</div>
		}
	</section>
}

templ factoryV1TextInput(id, name, label, placeholder string, required bool) {
	<label class="block space-y-1 text-xs text-warm-muted" for={ id }>
		<span>{ label }</span>
		<input id={ id } name={ name } type="text" placeholder={ placeholder } required?={ required } hx-preserve class="w-full rounded border border-edge bg-void px-3 py-2 text-sm text-warm outline-none focus:border-brand"/>
	</label>
}

templ factoryV1IdeaCard(idea FactoryV1Idea, writable bool) {
	<article class="rounded-lg border border-edge bg-surface p-4" data-factory-v1-idea={ idea.IdeaID }>
		<div class="flex flex-wrap items-start justify-between gap-2">
			<div>
				<h5 class="text-sm font-medium text-warm">{ factoryV1Value(idea.Title, "Untitled idea") }</h5>
				<p class="mt-1 font-mono text-[11px] text-warm-faint">{ factoryV1Value(idea.IdeaID, "idea id missing") } · { factoryV1Value(idea.TargetRepository, "repository missing") }</p>
			</div>
			<span class="rounded-full border border-edge px-2 py-1 text-[10px] uppercase tracking-wide text-warm-muted">{ factoryV1Value(idea.Status, "status missing") } · r{ strconv.Itoa(idea.CurrentRevision) }</span>
		</div>
		if len(idea.Revisions) == 0 {
			<p class="mt-3 text-xs text-amber-300">No candidate revision is projected; approval remains unavailable.</p>
		} else {
			<div class="mt-3 space-y-2">
				for _, revision := range idea.Revisions {
					<details class="rounded border border-edge bg-void/50 p-3" open?={ revision.Revision == idea.CurrentRevision }>
						<summary class="cursor-pointer text-xs text-warm-secondary">Revision { strconv.Itoa(revision.Revision) } · { factoryV1IdeaRevisionTime(revision) }</summary>
						<p class="mt-2 text-xs text-warm-muted">{ factoryV1IdeaRevisionInstruction(revision) }</p>
						<pre class="mt-2 max-h-64 overflow-auto whitespace-pre-wrap break-words rounded bg-void p-3 font-mono text-[11px] text-warm-secondary">{ factoryV1RawSummary(revision.Candidate, "candidate unavailable") }</pre>
						if len(revision.ValidationErrors) > 0 {
							<ul class="mt-2 list-disc space-y-1 pl-5 text-xs text-amber-300">
								for _, item := range revision.ValidationErrors {
									<li>{ item }</li>
								}
							</ul>
						}
					</details>
				}
			</div>
		}
		if writable && factoryV1IDPattern.MatchString(idea.IdeaID) {
			<div class="mt-4 grid gap-3 lg:grid-cols-[1fr_auto]">
				<form method="post" action={ templ.SafeURL("/console/factory-v1/ideas/" + idea.IdeaID + "/refine") } class="flex gap-2" data-factory-v1-form="refine">
					<label class="sr-only" for={ "factory-v1-refine-" + idea.IdeaID }>Refinement instruction</label>
					<input id={ "factory-v1-refine-" + idea.IdeaID } name="instruction" type="text" required maxlength="12000" hx-preserve class="min-w-0 flex-1 rounded border border-edge bg-void px-3 py-2 text-sm text-warm outline-none focus:border-brand" placeholder="Specify the next bounded refinement"/>
					<button type="submit" class="rounded border border-brand px-3 py-2 text-sm text-brand hover:bg-brand/10">Refine</button>
				</form>
				if factoryV1IdeaApprovable(idea) {
					<form method="post" action={ templ.SafeURL("/console/factory-v1/ideas/" + idea.IdeaID + "/submit") } data-factory-v1-form="approve-idea">
						<input type="hidden" name="revision" value={ strconv.Itoa(idea.CurrentRevision) }/>
						<input type="hidden" name="candidate_sha256" value={ factoryV1CurrentIdeaSHA256(idea) }/>
						<button type="submit" class="w-full rounded bg-brand px-3 py-2 text-sm font-medium text-void hover:opacity-90">Approve candidate</button>
					</form>
				}
			</div>
		}
	</article>
}

templ factoryV1InterventionQueue(items []FactoryV1Intervention, writable bool) {
	<section class="space-y-3" data-factory-v1-interventions>
		<div>
			<h3 class="text-sm font-medium text-warm">Intervention queue</h3>
			<p class="mt-1 text-xs text-warm-muted">A bounded resolution records one Human action and resumes only the referenced order.</p>
		</div>
		if len(items) == 0 {
			<p class="rounded-lg border border-edge bg-surface p-4 text-sm text-warm-muted" data-state="empty">No interventions projected.</p>
		} else {
			<div class="space-y-3">
				for _, item := range items {
					<article class="rounded-lg border border-amber-500/40 bg-surface p-4" data-intervention-id={ item.InterventionID }>
						<div class="flex flex-wrap items-start justify-between gap-2">
							<div>
								<p class="text-sm font-medium text-warm">{ factoryV1Value(item.Kind, "unspecified intervention") }</p>
								<p class="mt-1 font-mono text-[11px] text-warm-faint">{ factoryV1Value(item.InterventionID, "id missing") } · order { factoryV1Value(item.OrderID, "missing") }</p>
							</div>
							<span class="rounded-full border border-amber-500/40 px-2 py-1 text-[10px] uppercase tracking-wide text-amber-300">{ factoryV1Value(item.Status, "status missing") }</span>
						</div>
						<p class="mt-3 text-sm text-warm-secondary">{ factoryV1Value(item.Prompt, "No Human prompt was projected.") }</p>
						<p class="mt-2 text-[11px] text-warm-faint">requested { factoryV1Value(item.RequestedAt, "time missing") } · event { factoryV1Value(item.EventID, "missing") }</p>
						if writable && factoryV1InterventionOpen(item.Status) && factoryV1IDPattern.MatchString(item.InterventionID) {
							<form method="post" action={ templ.SafeURL("/console/factory-v1/interventions/" + item.InterventionID + "/resolve") } class="mt-4 flex gap-2" data-factory-v1-form="resolve-intervention">
								<label class="sr-only" for={ "factory-v1-resolution-" + item.InterventionID }>Resolution</label>
								<input id={ "factory-v1-resolution-" + item.InterventionID } name="resolution" type="text" required maxlength="12000" hx-preserve class="min-w-0 flex-1 rounded border border-edge bg-void px-3 py-2 text-sm text-warm outline-none focus:border-brand" placeholder="State the bounded resolution and evidence"/>
								<button type="submit" class="rounded bg-amber-400 px-3 py-2 text-sm font-medium text-void hover:opacity-90">Resolve and resume</button>
							</form>
						}
					</article>
				}
			</div>
		}
	</section>
}

templ factoryV1Orders(orders []FactoryV1OrderView) {
	<section class="space-y-3" data-factory-v1-orders>
		<div>
			<h3 class="text-sm font-medium text-warm">All orders</h3>
			<p class="mt-1 text-xs text-warm-muted">Every canonical channel shares this TLC ledger. Missing evidence converts the displayed state to blocked.</p>
		</div>
		if len(orders) == 0 {
			<p class="rounded-lg border border-edge bg-surface p-6 text-sm text-warm-muted" data-state="empty">No accepted orders projected.</p>
		} else {
			<div class="grid gap-4 xl:grid-cols-2">
				for _, order := range orders {
					@factoryV1OrderCard(order)
				}
			</div>
		}
	</section>
}

templ factoryV1OrderCard(view FactoryV1OrderView) {
	<article class="space-y-4 rounded-lg border border-edge bg-surface p-4" data-order-id={ view.Order.OrderID } data-order-status={ view.EffectiveStatus }>
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div class="min-w-0">
				<p class="text-[10px] uppercase tracking-widest text-warm-faint">{ factoryV1Value(view.Order.Channel, "channel missing") }</p>
				<h4 class="mt-1 text-base font-medium text-warm">{ factoryV1Value(view.Order.Title, "Untitled order") }</h4>
				<p class="mt-1 break-all font-mono text-[11px] text-warm-faint">{ factoryV1Value(view.Order.OrderID, "order id missing") } · v{ factoryV1Value(view.Order.Version, "?") }</p>
			</div>
			@factoryV1StatusBadge(view.EffectiveStatus, view.Order.ActivelyExecuting)
		</div>

		if len(view.Missing) > 0 {
			<p class="rounded border border-amber-500/40 bg-amber-500/5 px-3 py-2 text-xs text-amber-300" data-state="evidence-missing">Blocked fail-closed: missing { factoryV1Join(view.Missing, "canonical evidence") }.</p>
		}

		<div class="grid grid-cols-2 gap-x-4 gap-y-3 text-xs md:grid-cols-3">
			@factoryV1Definition("TLC stage", fmt.Sprintf("%d · %s", view.Order.TLCIndex, factoryV1Value(view.Order.TLCStage, "missing")))
			@factoryV1Definition("elapsed", factoryV1Elapsed(view.Order.ElapsedMS))
			@factoryV1Definition("peers", factoryV1Join(view.Order.Peers, "none projected"))
			@factoryV1Definition("gate", factoryV1Value(view.Order.GateState, "missing"))
			@factoryV1Definition("attempt", factoryV1Value(view.Order.ActiveAttemptID, "none active"))
			@factoryV1Definition("budget", factoryV1BudgetLabel(view.Order.Budget))
		</div>

		<div class="grid gap-3 text-xs md:grid-cols-2">
			<div class="rounded border border-edge bg-void/50 p-3">
				<p class="text-[10px] uppercase tracking-widest text-warm-faint">blocker</p>
				<p class="mt-1 text-warm-secondary">{ factoryV1Value(view.Order.Blocker, "none projected") }</p>
			</div>
			<div class="rounded border border-edge bg-void/50 p-3">
				<p class="text-[10px] uppercase tracking-widest text-warm-faint">next action</p>
				<p class="mt-1 text-warm-secondary">{ factoryV1Value(view.Order.NextAction, "missing") }</p>
			</div>
		</div>

		<details class="rounded border border-edge bg-void/40 p-3">
			<summary class="cursor-pointer text-xs font-medium text-warm-secondary">Authority, PR, and canonical receipts</summary>
			<dl class="mt-3 grid gap-2 text-xs md:grid-cols-2">
				@factoryV1Definition("source", factoryV1RawSummary(view.Order.SourceRef, "missing"))
				@factoryV1Definition("document SHA-256", factoryV1Value(view.Order.DocumentSHA256, "missing"))
				@factoryV1Definition("Human approval", factoryV1Value(view.Order.HumanApprovalBasis, "not yet projected"))
				@factoryV1Definition("approval receipt", factoryV1RawSummary(view.Order.HumanApprovalReceipt, "not yet projected"))
				@factoryV1Definition("PR", factoryV1PRLabel(view.Order.PR))
				@factoryV1Definition("head / reviewed", factoryV1Value(view.Order.PR.HeadSHA, "missing") + " / " + factoryV1Value(view.Order.PR.ReviewedHeadSHA, "missing"))
				@factoryV1Definition("checks", factoryV1PRChecks(view.Order.PR))
				@factoryV1Definition("PR state", factoryV1PRState(view.Order.PR))
			</dl>
			if view.Order.PR.URL != "" {
				<a href={ templ.URL(view.Order.PR.URL) } target="_blank" rel="noreferrer" class="mt-3 inline-block text-xs text-brand hover:underline">Open pull request ↗</a>
			}
		</details>

		<details class="rounded border border-edge bg-void/40 p-3">
			<summary class="cursor-pointer text-xs font-medium text-warm-secondary">Evidence ({ strconv.Itoa(len(view.Order.Evidence)) })</summary>
			if len(view.Order.Evidence) == 0 {
				<p class="mt-3 text-xs text-amber-300">No canonical evidence projected.</p>
			} else {
				<ul class="mt-3 space-y-2">
					for _, evidence := range view.Order.Evidence {
						@factoryV1EvidenceItem(evidence)
					}
				</ul>
			}
		</details>

		<details class="rounded border border-edge bg-void/40 p-3">
			<summary class="cursor-pointer text-xs font-medium text-warm-secondary">TLC stage ledger ({ strconv.Itoa(len(view.Order.Stages)) })</summary>
			if len(view.Order.Stages) == 0 {
				<p class="mt-3 text-xs text-amber-300">No stage ledger projected.</p>
			} else {
				<ol class="mt-3 space-y-2">
					for i, stage := range view.Order.Stages {
						<li class="rounded border border-edge px-3 py-2 text-xs">
							<div class="flex items-center justify-between gap-2">
								<span class="font-mono text-warm-secondary">{ strconv.Itoa(i + 1) }. { factoryV1Value(stage.Stage, "stage missing") }</span>
								<span class="text-warm-muted">{ factoryV1StageState(stage) }</span>
							</div>
							<p class="mt-1 break-all text-[11px] text-warm-faint">attempt { factoryV1Value(stage.AttemptID, "none") } · { factoryV1StageTime(stage) } · event { factoryV1Value(stage.EventID, "not projected") }</p>
							<p class="mt-1 text-[11px] text-warm-faint">peers { factoryV1Join(stage.Peers, "none projected") } · artifact { factoryV1Value(stage.WorkArtifactID, "not projected") } · recovered { strconv.FormatBool(stage.Recovered) }</p>
						</li>
					}
				</ol>
			}
		</details>
	</article>
}

templ factoryV1StatusBadge(status string, executing bool) {
	switch status {
		case "progressing":
			<span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/40 px-2 py-1 text-[10px] uppercase tracking-wide text-emerald-300">
				<span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>{ status }
				if executing {
					<span>· active</span>
				}
			</span>
		case "human_required", "human_review":
			<span class="inline-flex items-center gap-1.5 rounded-full border border-violet-500/40 px-2 py-1 text-[10px] uppercase tracking-wide text-violet-300"><span class="h-1.5 w-1.5 rounded-full bg-violet-400"></span>{ status }</span>
		default:
			<span class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/40 px-2 py-1 text-[10px] uppercase tracking-wide text-amber-300"><span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>{ factoryV1Value(status, "blocked") }</span>
	}
}

templ factoryV1Definition(label, value string) {
	<div class="min-w-0">
		<dt class="text-[10px] uppercase tracking-widest text-warm-faint">{ label }</dt>
		<dd class="mt-1 break-words text-warm-secondary">{ value }</dd>
	</div>
}

templ factoryV1EvidenceItem(evidence FactoryV1Evidence) {
	<li class="rounded border border-edge px-3 py-2 text-xs">
		<p class="text-warm-secondary">{ factoryV1Value(evidence.Kind, "kind missing") } · { factoryV1EvidenceReference(evidence) }</p>
		<p class="mt-1 break-all font-mono text-[10px] text-warm-faint">sha { factoryV1Value(evidence.SHA256, "missing") } · event { factoryV1Value(evidence.EventID, "missing") }</p>
		<p class="mt-1 break-all font-mono text-[10px] text-warm-faint">{ factoryV1EvidenceExactness(evidence) }</p>
	</li>
}
