package graph

import (
	"fmt"
)

templ CivilizationWorkbenchFragment(data CivilizationWorkbench) {
	<section id="civilization-workbench" class="wb-workbench" data-console-surface="civilization-workbench" hx-history="false">
		<header class="wb-heading"><h1>Workbench</h1><p>Briefs, progress and results in one place.</p></header>
		if len(data.Repositories) > 0 && data.CanOperate() {
			<details id="workbench-composer" class="wb-composer" open?={ len(data.Items) == 0 || data.FormText != "" }>
				<summary class="wb-button wb-primary"><span class="wb-when-closed">+ New work</span><span class="wb-when-open">Close composer</span></summary>
				<form id="workbench-intake-form" method="post" action="/console/workbench/intake" hx-post="/console/workbench/intake" hx-target="#civilization-workbench" hx-swap="outerHTML" hx-disabled-elt="button" class="wb-compose-form" aria-label="New work">
					<input type="hidden" name="source_identity" value={ data.IntakeIdentity }/>
					<input type="hidden" name="selected_work" value={ data.SelectedWorkID }/>
					@civilizationViewFields(data)
					<div><h2>What should Civilization accomplish?</h2><p class="wb-muted">Describe a repository improvement. You review the brief before implementation.</p></div>
					<label>Outcome<textarea id="workbench-outcome" name="text" required maxlength="20000" rows="3" placeholder="For example: Add a troubleshooting section for failed verification to the operator guide.">{ data.FormText }</textarea></label>
					<div class="wb-fields">
						<label>Repository<select name="repository" required>
							for _, repository := range data.Repositories {
								<option value={ repository } selected?={ repository == data.FormRepository }>{ civilizationRepositoryLabel(repository) }</option>
							}
						</select></label>
						<label>Execution host<select name="provider"><option value="">Configured host</option><option value="codex" selected?={ data.FormSelection.Provider == "codex" }>Codex</option><option value="claude" selected?={ data.FormSelection.Provider == "claude" }>Claude</option></select></label>
					</div>
					<details id="workbench-model-options" open?={ data.FormSelection.Model != "" || data.FormSelection.ReasoningEffort != "" }><summary>Model and reasoning options</summary><div class="wb-fields wb-options">
						<label>Model (optional)<input name="model" list="workbench-model-catalog" maxlength="200" value={ data.FormSelection.Model } placeholder="Selected host’s default"/></label>
						<datalist id="workbench-model-catalog">
							for _, model := range data.ModelOptions {
								<option value={ model.ID }>{ model.Provider }</option>
							}
						</datalist>
						<label>Reasoning effort (optional)<select name="reasoning_effort"><option value="">Host default</option>
							for _, effort := range []string{"low", "medium", "high", "xhigh", "max"} {
								<option value={ effort } selected?={ data.FormSelection.ReasoningEffort == effort }>{ effort }</option>
							}
						</select></label>
					</div></details>
					<div class="wb-actions"><p class="wb-muted">Preparing a brief records your request and uses the selected host.</p><button type="submit" class="wb-button wb-primary">Prepare brief</button></div>
				</form>
			</details>
		}
		<div id="workbench-connection" role="status" aria-live="polite"></div>
		@CivilizationWorkList(data)
	</section>
}

templ CivilizationWorkList(data CivilizationWorkbench) {
	<div id="civilization-work-list" hx-get={ data.PollURL() } hx-trigger="every 3s" hx-swap="outerHTML" hx-sync="this:drop" data-selected-work={ data.SelectedWorkID } data-view={ data.View } data-available={ fmt.Sprint(data.Available) }>
		<div id="workbench-action-notice" data-action-error={ fmt.Sprint(data.ActionError) }>
			if data.Notice != "" {
				<div class="wb-notice" role="alert">{ data.Notice }</div>
			}
		</div>
		@civilizationWorkbenchToolbar(data)
		<div class="wb-list-heading"><h2 id="workbench-list-title">
			if data.View == "history" {
				History
			} else {
				Current work
			}
			<span>{ fmt.Sprint(len(data.VisibleItems())) }</span>
		</h2><div class="wb-freshness"><span class="wb-live">Updates automatically</span><time datetime={ data.GeneratedAt.Format("2006-01-02T15:04:05Z") }>Checked { data.GeneratedAt.Format("15:04:05 UTC") }</time></div></div>
		if !data.Available {
			<div class="wb-empty" role="status"><h2>Progress is temporarily unavailable</h2><p>Reconnecting automatically. Your request may already be recorded.</p></div>
		} else if len(data.Items) == 0 {
			<div class="wb-empty"><span class="wb-empty-mark" aria-hidden="true">◇</span><h2>Your next improvement starts here</h2><p>Describe an outcome above. Civilization will prepare a brief for you to review.</p></div>
		} else if data.View == "team" {
			@civilizationTeamBoard(data)
		} else if len(data.VisibleItems()) == 0 {
			@civilizationWorkEmpty(data)
		} else {
			<div class="wb-board">
				<details id="workbench-picker" class="wb-index" open><summary>Select work · { fmt.Sprint(len(data.VisibleItems())) } items</summary><nav aria-label="Select work">
					for _, group := range data.Groups() {
						if len(group.Items) > 0 {
							<section class="wb-work-group"><h3>{ group.Label } <span>{ fmt.Sprint(len(group.Items)) }</span></h3>
								for _, work := range group.Items {
									<a id={ "work-select-"+work.WorkID } href={ templ.URL(data.PageURL(data.View, work.WorkID)) } hx-get={ data.FragmentURL(data.View, work.WorkID) } hx-target="#civilization-work-list" hx-swap="outerHTML" hx-push-url={ data.PageURL(data.View, work.WorkID) } hx-sync="#civilization-work-list:replace" class="wb-work-link" data-work-select={ work.WorkID } aria-current={ civilizationSelectedCurrent(data, work.WorkID) }>
										<span class="wb-work-meta">{ civilizationRepositoryLabel(work.Source.Repository) }</span><span class="wb-work-title">{ civilizationWorkOutcome(work) }</span><span class="wb-work-state" data-state={ work.State }>{ civilizationStateLabel(work.State) }</span>
									</a>
								}
							</section>
						}
					}
				</nav></details>
				if work := data.Selected(); work != nil {
					@civilizationWorkDetail(*work, data)
				} else {
					<div class="wb-empty" role="status"><h2>This work is no longer available</h2><p>Select another item to view its progress.</p></div>
				}
			</div>
		}
		if data.Available && data.View != "history" && len(data.HistoryItems()) > 0 {
			<details id="workbench-history" class="wb-history" data-workbench-details>
				<summary>History <span>{ fmt.Sprint(len(data.HistoryItems())) }</span><small>Reviewed and completed work</small></summary>
				<nav aria-label="Work history">
					for _, work := range data.HistoryItems() {
						<a id={ "history-work-"+work.WorkID } class="wb-history-row" href={ templ.URL(data.PageURL("history", work.WorkID)) } hx-get={ data.FragmentURL("history", work.WorkID) } hx-target="#civilization-work-list" hx-swap="outerHTML" hx-sync="#civilization-work-list:replace" data-work-select={ work.WorkID }>
							<span><span class="wb-work-meta">{ civilizationRepositoryLabel(work.Source.Repository) }</span><strong>{ civilizationWorkOutcome(work) }</strong></span>
							<span class="wb-history-status">{ civilizationStateLabel(work.State) }</span>
							<time datetime={ work.UpdatedAt.Format("2006-01-02T15:04:05Z") }>{ work.UpdatedAt.Format("02 Jan · 15:04 UTC") }</time>
						</a>
					}
				</nav>
			</details>
		}
	</div>
}

templ civilizationWorkEmpty(data CivilizationWorkbench) {
	<div class="wb-empty" role="status">
		if data.Repository != "" || data.Operator != "" || data.Responsible != "" {
			<h2>No work matches these filters</h2><p>Choose another repository or person to see their work.</p>
		} else if data.View == "history" {
			<h2>No reviewed or completed work yet</h2><p>Results will appear here after you review them.</p>
		} else {
			<h2>You're all caught up</h2><p>Reviewed and completed work is saved in History. Start new work whenever you're ready.</p>
		}
	</div>
}
